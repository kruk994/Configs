#!/usr/bin/env python3
"""mdcp — pick a fenced code block from a markdown file and copy it verbatim.
Managed by chezmoi -- edit dot_local/bin/executable_mdcp in ~/git/configs.

Usage: mdcp FILE.md [N]   (N = copy block number N without the picker)
       mdcp FILE.md -v    (view in glow with #N labels above each block;
                           -v may also come first)
       cglow FILE.md      (same as mdcp FILE.md -v)
       cglow FILE.md N    (same as mdcp FILE.md N)

In the viewer press c, type the block number and Enter to copy it.
"""
import os
import re
import subprocess
import sys
import tempfile
import unicodedata

FENCE = re.compile(r"^( {0,3})(`{3,}|~{3,})(.*)$")


def blocks(text):
    out, cur = [], None
    for no, line in enumerate(text.splitlines(keepends=True)):
        m = FENCE.match(line.rstrip("\n"))
        if cur is None:
            if m and not (m.group(2)[0] == "`" and "`" in m.group(3)):
                cur = {"start": no, "indent": len(m.group(1)), "fence": m.group(2),
                       "lang": m.group(3).strip().split(" ")[0], "lines": []}
        elif m and m.group(2)[0] == cur["fence"][0] \
                and len(m.group(2)) >= len(cur["fence"]) and not m.group(3).strip():
            cur["end"] = no
            out.append(cur)
            cur = None
        else:
            # strip up to the opening fence's indent, as CommonMark does
            n = len(line) - len(line.lstrip(" "))
            cur["lines"].append(line[min(n, cur["indent"]):])
    if cur is not None:  # unclosed fence runs to end of document
        cur["end"] = no
        out.append(cur)
    for b in out:
        b["code"] = "".join(b["lines"]).rstrip("\n")
    return out


TOP, END = "@@mdcp-top@@", "@@mdcp-end@@"  # markers, removed after rendering
BG = "\x1b[48;5;236m"  # same gray as glow's inline code, so #N reads as a tab
ANSI = re.compile(r"\x1b\[[0-9;]*m")


def cells(s):
    plain = ANSI.sub("", s)
    return sum(2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in plain)


def expandtabs(s):
    # str.expandtabs would count escape codes as columns
    out, col = [], 0
    for part in re.split(f"({ANSI.pattern})", s):
        if ANSI.fullmatch(part):
            out.append(part)
            continue
        for c in part:
            if c == "\t":
                out.append(" " * (8 - col % 8))
                col += 8 - col % 8
            else:
                out.append(c)
                col += 1
    return "".join(out)


def paint(code, indent):
    """Give rendered code lines a background, padded into one rectangle."""
    code = [expandtabs(l) for l in code]
    while code and not ANSI.sub("", code[0]).strip():
        code.pop(0)
    while code and not ANSI.sub("", code[-1]).strip():
        code.pop()
    body = [l[indent:] if l.startswith(" " * indent) else l for l in code]
    width = max(map(cells, body), default=0) + 2
    out = []
    for l in [""] + body + [""]:  # one row of padding above and below
        # a reset inside the line would drop the background, so re-apply it
        l = re.sub(r"\x1b\[0?m", lambda m: m.group(0) + BG, l)
        out.append(" " * indent + BG + l + " " * (width - cells(l)) + "\x1b[0m")
    return out


def boxed(rendered):
    out, code = [], None
    for line in rendered.split("\n"):
        plain = ANSI.sub("", line)
        if TOP in plain:
            out.append(line.replace(TOP, ""))
            code = []
        elif END in plain and code is not None:
            out.extend(paint(code, len(plain) - len(plain.lstrip(" "))))
            code = None
        elif code is not None:
            code.append(line)
        else:
            out.append(line)
    return "\n".join(out)


def glow_style():
    # glow ignores its config style when piped, so pass it explicitly
    try:
        with open(os.path.expanduser("~/.config/glow/glow.yml")) as f:
            m = re.search(r'^style:\s*"?([^"\n]+)"?', f.read(), re.M)
        if m and m.group(1).strip() != "auto":
            return os.path.expanduser(m.group(1).strip())
    except OSError:
        pass
    return "dark"


def view(path):
    with open(path, encoding="utf-8") as f:
        text = f.read()
    lines = text.splitlines(keepends=True)
    if lines and not lines[-1].endswith("\n"):
        lines[-1] += "\n"
    for i, b in reversed(list(enumerate(blocks(text), 1))):
        indent = " " * b["indent"]
        name = f"`#{i}` *{b['lang']}*" if b["lang"] else f"`#{i}`"
        label = f"{name} {TOP}"
        lines.insert(b["end"] + 1, f"\n{indent}{END}\n\n")
        s = b["start"]
        if b["indent"]:
            # inside a list glow joins paragraphs onto one line, so hang the
            # label off the previous line with a hard break instead
            while s > 0 and not lines[s - 1].strip():
                del lines[s - 1]
                s -= 1
            if s > 0:
                lines[s - 1] = lines[s - 1].rstrip("\n") + "  \n"
            lines.insert(s, f"{indent}{label}\n")
        else:
            # blank line first, so the label never merges into a paragraph
            lines.insert(s, f"\n{label}\n")
    # c in less prefills a shell prompt with "cglow ", so "c 3 Enter" copies #3
    with tempfile.TemporaryDirectory(prefix="mdcp-") as tmp:
        keys = os.path.join(tmp, "lesskey")
        with open(keys, "w") as f:
            f.write("#command\nc shell cglow\\ \n")
        md = os.path.join(tmp, os.path.basename(path))
        with open(md, "w", encoding="utf-8") as f:
            f.write("".join(lines))
        # no terminal at all for glow: otherwise it queries the terminal's
        # colors and the replies end up in less as keystrokes
        r = subprocess.run(["glow", "-w", "0", "-s", glow_style(), md],
                           stdin=subprocess.DEVNULL, capture_output=True,
                           env=dict(os.environ, CLICOLOR_FORCE="1"))
        if r.returncode:
            sys.exit(r.stderr.decode() or "glow failed")
        env = dict(os.environ, MDCP_FILE=os.path.abspath(path))
        subprocess.run(["less", "-R", f"--lesskey-src={keys}"],
                       input=boxed(r.stdout.decode()).encode(), env=env)


def copy(code):
    subprocess.run(["wl-copy", "--"], input=code.encode(), check=True)


def say(msg):
    # glow starts its pager with stderr discarded, so in the viewer
    # write straight to the terminal or the message is lost
    if os.environ.get("MDCP_FILE"):
        try:
            with open("/dev/tty", "w") as tty:
                print(msg, file=tty)
            return
        except OSError:
            pass
    print(msg, file=sys.stderr)


def fail(msg):
    say(f"✗ Nic nie skopiowano: {msg}")
    sys.exit(1)


def main(path, n=None):
    try:
        with open(path, encoding="utf-8") as f:
            bs = blocks(f.read())
    except OSError as e:
        fail(f"nie mogę otworzyć {path} ({e.strerror})")
    if not bs:
        fail("w pliku nie ma bloków kodu")

    if n is not None:
        if not 1 <= n <= len(bs):
            fail(f"nie ma bloku #{n} (bloki: #1–#{len(bs)})")
    elif len(bs) == 1:
        n = 1
    else:
        rows = []
        for i, b in enumerate(bs, 1):
            # whole block on one row, so fzf matches any line of it
            flat = " ⏎ ".join(l.strip() for l in b["lines"] if l.strip())
            rows.append(f"{i}\t{b['lang'] or '-':<8} {flat}")
        preview = (f"{sys.executable} {os.path.abspath(__file__)} "
                   f"--show {{1}} {path!r}")
        r = subprocess.run(
            ["fzf", "--delimiter=\t", "--with-nth=1..", "--reverse",
             "--preview", preview, "--preview-window=down,70%"],
            input="\n".join(rows).encode(), stdout=subprocess.PIPE)
        if r.returncode != 0:
            sys.exit(1)
        n = int(r.stdout.decode().split("\t")[0])

    b = bs[n - 1]
    copy(b["code"])
    k = len(b["code"].splitlines())
    say(f"✓ Skopiowano blok #{n} ({b['lang'] or 'plain'}, linie: {k})")


if __name__ == "__main__":
    if len(sys.argv) == 4 and sys.argv[1] == "--show":
        with open(sys.argv[3], encoding="utf-8") as f:
            b = blocks(f.read())[int(sys.argv[2]) - 1]
        try:
            subprocess.run(["bat", "--color=always", "--style=plain",
                            "--paging=never", "-l", b["lang"] or "txt"],
                           input=b["code"].encode(), check=True,
                           stderr=subprocess.DEVNULL)
        except (subprocess.CalledProcessError, FileNotFoundError):
            print(b["code"])
    else:
        args = sys.argv[1:]
        viewed = os.environ.get("MDCP_FILE")  # set only inside the viewer
        if viewed and not (args and os.path.isfile(args[0])):
            # typed at the viewer's "c" prompt: expect exactly one number
            if len(args) != 1 or not args[0].isdigit():
                got = " ".join(args)
                fail(f"„{got}” to nie numer bloku" if got else "nie podano numeru")
            main(viewed, int(args[0]))
        elif os.path.basename(sys.argv[0]) == "cglow":
            if len(args) == 1:
                view(args[0])
            elif len(args) == 2 and args[1].isdigit():
                main(args[0], int(args[1]))
            else:
                sys.exit("Usage: cglow FILE.md [N]")
        elif "-v" in args:
            args.remove("-v")
            if len(args) != 1:
                sys.exit(__doc__.strip())
            view(args[0])
        elif len(args) == 1:
            main(args[0])
        elif len(args) == 2 and args[1].isdigit():
            main(args[0], int(args[1]))
        else:
            sys.exit(__doc__.strip())
