# shellcheck shell=sh
# ── 42 shell fragment ───────────────────────────────────────────────────────
# POSIX only: sourced from ~/.bashrc (Omarchy) and ~/.zshrc (macOS, 42 Ubuntu).
# Managed by chezmoi -- edit dot_config/shell/42.sh.tmpl in ~/git/configs.

# The 42 identity. Deliberately NOT `export USER=...`: the previous Mac .zshrc
# overrode the system $USER process-wide, which affects every program started
# from the shell. stdheader.vim and 42-header.nvim read USER42/MAIL42.
export USER42={{ .user42 | quote }}
export MAIL42={{ .mail42 | quote }}

# norminette and a locally installed nvim live here on all three machines.
case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) PATH="$HOME/.local/bin:$PATH"; export PATH ;;
esac

# ── Compiling at 42 ─────────────────────────────────────────────────────────
alias cc='cc -Wall -Wextra -Werror'
alias com='cc -o code.out'
alias comf='cc -Wall -Wextra -Werror -o code.out'
alias coma='cc -o code.out *.c'
alias comfa='cc -Wall -Wextra -Werror -o code.out *.c'
alias norm='norminette'

# ── Everyday ────────────────────────────────────────────────────────────────
alias ll='ls -lA'
alias cl='clear'

# mkdir + cd in one step.
mkcd() {
    mkdir -p -- "$1" && cd -P -- "$1" || return
}

# Legend for the starship prompt (~/.config/starship.toml). Same icons, same
# ANSI colours, so it follows the theme like the prompt does.
prompt-help() {
    e=$(printf '\033')
    r="$e[0m" d="$e[90m" B="$e[1m"
    red="$e[31m" grn="$e[32m" yel="$e[33m" blu="$e[34m" mag="$e[35m" cyn="$e[36m"
    cat <<EOF

${B}Linia 1, po lewej${r}
  ${blu}  ${r}      system: Arch / macOS / Ubuntu (42)
  ${yel}user@host${r}  tylko przez SSH albo jako root
  ${grn}${r}          jesteś w terminalu wewnątrz Neovima
  ${blu}${B} ~/ścieżka${r}  pełna ścieżka; ${cyn}${B}nazwa repo${r} wyróżniona, ${red}${r} = brak zapisu

${B}Git${r}
  ${mag} main${r}      gałąź (${mag}main:origin/x${r} gdy upstream ma inną nazwę)
  ${mag} a1b2c3d${r}   odłączony HEAD: krótki hash; ${mag} v1.0${r} = tag
  ${yel}${B} REBASING 2/5${r}  trwa rebase / merge / cherry-pick / bisect
  ${yel}N${r}  N commitów do wypchnięcia (ahead)
  ${yel}N${r}  N commitów do pobrania (behind)
  ${yel} N${r}  pliki w stage (git add)
  ${yel} N${r}  pliki zmienione, nie dodane
  ${yel}N${r}  pliki nieśledzone (untracked)
  ${yel} N${r}  pliki usunięte
  ${yel} N${r}  pliki przemianowane
  ${yel} N${r}  wpisy w git stash
  ${yel} N${r}  konflikty do rozwiązania
  ${grn}N${r} ${red}N${r}  linie dodane / usunięte względem HEAD

${B}Linia 1, po prawej${r}
  ${d} 14.1   3.13   22${r}  wersja C / Pythona (+venv) / Node, gdy są pliki w katalogu
  ${yel} 4s${r}       ostatnia komenda trwała dłużej niż 2 s
  ${blu} N${r}        N zadań w tle (jobs, fg)
  ${red} 127${r}      kod błędu ostatniej komendy (INT = Ctrl-C, NOT_FOUND...)
  ${d} 17:04${r}     godzina wyświetlenia promptu

${B}Linia 2${r}
  ${cyn}${B}❯${r} ok   ${red}${B}❯${r} ostatnia komenda się nie udała

EOF
}

# Download a 42 subject PDF (cached) and read it as text. Example:
#   subject https://cdn.intra.42.fr/pdf/pdf/96987/en.norm.pdf
subject() {
    wget -NP "$HOME/.cache" -nv -- "$1" &&
        pdftotext -nopgbrk -layout -- "$HOME/.cache/${1##*/}" - | uniq | less
}

# ── zsh basics ──────────────────────────────────────────────────────────────
# macOS's /etc/zshrc saves history and Omarchy runs bash, but Ubuntu's
# /etc/zsh/zshrc does neither: without this, history dies with the terminal
# and Tab completes only file names. Every line defers to an existing setup
# (oh-my-zsh, a campus .zshrc) -- nothing is overridden. Plain commands only,
# so bash can still parse this file.
if [ -n "${ZSH_VERSION:-}" ]; then
    [ -n "${HISTFILE:-}" ] || HISTFILE="$HOME/.zsh_history"
    [ "${SAVEHIST:-0}" -ge 10000 ] || SAVEHIST=10000
    [ "${HISTSIZE:-0}" -ge 10000 ] || HISTSIZE=10000
    setopt APPEND_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_SPACE
    if ! typeset -f compdef >/dev/null 2>&1; then
        autoload -Uz compinit && compinit -i
    fi
fi

# ── Prompt ──────────────────────────────────────────────────────────────────
# Start starship unless something already did: Omarchy's bash rc runs
# `starship init bash` before this file, and starship exports STARSHIP_SHELL.
case $- in
    *i*)
        if [ -z "${STARSHIP_SHELL:-}" ] && command -v starship >/dev/null 2>&1; then
            if [ -n "${ZSH_VERSION:-}" ]; then
                eval "$(starship init zsh)"
            elif [ -n "${BASH_VERSION:-}" ]; then
                eval "$(starship init bash)"
            fi
        fi
        ;;
esac
