{{- /* Sourced by star-wars-theme. Called with (dict "id" <planet key> "p" <planet>). */ -}}
# Generated by chezmoi from .chezmoidata/star-wars.yaml in ~/git/configs.
SW_ID={{ .id | quote }}
SW_NAME={{ printf "Star Wars %s" .p.name | quote }}
SW_GNOME_ACCENT={{ .p.gnomeAccent | quote }}
SW_ICONS={{ .p.icons | quote }}
SW_BORDER1={{ index .p.border.colors 0 | quote }}
SW_BORDER2={{ index .p.border.colors 1 | quote }}
SW_BORDER_ANGLE={{ .p.border.angle | quote }}
{{- range $k, $v := .p.colors }}
SW_{{ upper $k }}={{ $v | quote }}
{{- end }}
